#!/usr/bin/env bash
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
. "$REPO/bin/lib.sh"

CONFIG="$REPO/config.toml"

usage() {
    cat <<EOF
sandbox — ad-hoc Linux sandboxes on Apple Container

  sandbox                    Open the menu (launch, or stop/rename/delete).
  sandbox <name>             Launch <name> and attach a shell to it.
  sandbox -d <name>          Launch <name> without attaching anything.
  sandbox --image <ref>      Run <name> on this image from now on.
  sandbox --pull <name>      Fetch the image again before launching.
  sandbox --ssh-port <port>  Serve <name>'s SSH on this port of the Mac.
  sandbox --help             This help.

Sandboxes run detached and keep running when you leave the shell, so a build
or an agent you start inside one survives closing the terminal. Stop one from
the menu or with \`container stop <name>\`.

Every sandbox runs a published image rather than one built here. It defaults to
$SANDBOX_DEFAULT_IMAGE, and \`[image].ref\` in
config.toml changes that for every sandbox. \`--image\` pins one sandbox to a
ref of its own, recorded in ~/Sandboxes/<name>/.sandbox-image; delete that file
to follow the config again.

Every sandbox also serves SSH, on a port of the Mac that is its own, so it can
be reached from anywhere that reaches the Mac, a tailnet included. The port is
kept in ~/Sandboxes/<name>/.sandbox-ssh-port and stays the same across launches.
Only a key gets in; there is no password.

Homes live under \$SANDBOX_HOMES (default ~/Sandboxes). The container mounts
only its home dir; drop files into ~/Sandboxes/<name> in Finder.
EOF
}

IMAGE_REF="" IMAGE_HOME="" IMAGE_USER="" IMAGE_SHELL="" IMAGE_DIGEST=""

# Fills the IMAGE_* globals from the image's own OCI config, so the mount
# target and the login name come from the image rather than from this Mac.
resolve_image() {
    local name="$1" pull="$2" configured_home lines
    IMAGE_REF="$(sandbox_image_ref "$CONFIG" "$name")"

    if ! valid_image_ref "$IMAGE_REF"; then
        echo "Invalid image ref: '$IMAGE_REF'." >&2
        return 2
    fi

    if [ "$pull" = 1 ]; then
        echo "Fetching $IMAGE_REF ..." >&2
        sandbox_image_pull "$IMAGE_REF" >&2 || return 1
    fi

    lines="$(sandbox_image_config "$IMAGE_REF")" || {
        echo "Fetching $IMAGE_REF ..." >&2
        sandbox_image_pull "$IMAGE_REF" >&2 || return 1
        lines="$(sandbox_image_config "$IMAGE_REF")" || {
            echo "Could not read the config of $IMAGE_REF." >&2
            return 1
        }
    }

    IMAGE_HOME="$(printf '%s\n' "$lines" | sed -n 1p)"
    IMAGE_USER="$(printf '%s\n' "$lines" | sed -n 2p)"
    IMAGE_SHELL="$(printf '%s\n' "$lines" | sed -n 3p)"
    IMAGE_DIGEST="$(printf '%s\n' "$lines" | sed -n 5p)"

    configured_home="$(sandbox_config "$CONFIG" image home "")"
    [ -n "$configured_home" ] && IMAGE_HOME="$configured_home"

    if [ -z "$IMAGE_HOME" ]; then
        echo "$IMAGE_REF declares no home directory, so there is nowhere to" >&2
        echo "mount '$name'. Name one with [image].home in config.toml." >&2
        return 1
    fi

    [ -n "$IMAGE_SHELL" ] || IMAGE_SHELL=/bin/sh
    return 0
}

# A numeric User is a uid, which names no account anyone can ssh to.
login_name() {
    case "$IMAGE_USER" in
        ""|*[!a-zA-Z0-9._-]*|[0-9]*) printf 'the image user\n' ;;
        *) printf '%s\n' "$IMAGE_USER" ;;
    esac
}

run_container() {
    local name="$1" home="$2"
    shift 2

    local -a resource_args=() env_args=()
    while IFS= read -r line; do resource_args+=("$line"); done \
        < <(sandbox_resource_args "$CONFIG")
    while IFS= read -r line; do env_args+=("$line"); done \
        < <(sandbox_image_env_args "$CONFIG")

    container run --detach --rm \
        --name "$name" \
        --volume "$home:$IMAGE_HOME" \
        ${resource_args[@]+"${resource_args[@]}"} \
        ${env_args[@]+"${env_args[@]}"} \
        --cap-add ALL \
        --init \
        "$@"
}

# Nothing injects TERM, so without this zellij and vim draw on a dumb terminal.
attach() {
    local name="$1" attach_cmd
    attach_cmd="$(sandbox_config "$CONFIG" image attach "")"

    if [ -n "$attach_cmd" ]; then
        container exec --interactive --tty \
            --env "TERM=${TERM:-xterm-256color}" \
            "$name" "$IMAGE_SHELL" -lc "$attach_cmd" || true
    else
        container exec --interactive --tty \
            --env "TERM=${TERM:-xterm-256color}" \
            "$name" "$IMAGE_SHELL" -l || true
    fi

    echo "'$name' is still running. Stop it from the menu, or with: container stop $name"
}

report_ssh() {
    local name="$1" port count
    sandbox_ssh_enabled "$CONFIG" || { echo "ssh: off in config.toml"; return 0; }
    port="$(sandbox_recorded_ssh_port "$name")"
    count="$(sandbox_authorized_key_count "$name")"
    if [ "$count" -eq 0 ]; then
        echo "ssh: no authorized key, so nothing can log in."
        echo "     add one to $(sandbox_authorized_keys_path "$name")"
        return 0
    fi
    echo "ssh: $count authorized key(s); ssh -p $port $(login_name)@127.0.0.1"
    echo "     the same port on the Mac's own address reaches it from elsewhere"
}

report_tunnel() {
    local name="$1" offset="$2" log waited=0 url
    log="$(sandbox_config "$CONFIG" image tunnel_log "")"
    [ -n "$log" ] || return 0
    log="$(sandbox_home_path "$name")/$log"

    while [ "$waited" -lt "${SANDBOX_TUNNEL_WAIT:-30}" ]; do
        if url="$(sandbox_tunnel_url "$log" "$offset")"; then
            echo "tunnel: $url"
            return 0
        fi
        sleep 2
        waited=$((waited + 2))
    done
    echo "tunnel: no link yet; the image reports it in ${log##*/}"
}

start_container() {
    local name="$1" home="$2" hold
    local -a ssh_args=()

    if sandbox_ssh_enabled "$CONFIG"; then
        sandbox_seed_authorized_keys "$name"
        ssh_args=(--publish "$(sandbox_ssh_address "$CONFIG"):$(sandbox_ssh_port "$CONFIG" "$name"):$(sandbox_config "$CONFIG" ssh container_port 22)")
    fi

    # `sleep infinity` is a GNU extension; busybox images reject it.
    hold="$(sandbox_config "$CONFIG" image hold 'sleep 2147483647')"

    echo "Launching '$name' on $IMAGE_REF ..." >&2
    # shellcheck disable=SC2086
    run_container "$name" "$home" ${ssh_args[@]+"${ssh_args[@]}"} \
        "$IMAGE_REF" $hold >/dev/null

    sandbox_set_mount "$name" "$IMAGE_HOME"
}

warn_moved_home() {
    local name="$1" previous
    previous="$(sandbox_recorded_mount "$name")"
    [ -n "$previous" ] || return 0
    [ "$previous" != "$IMAGE_HOME" ] || return 0
    echo "'$name' used to mount at $previous and now mounts at $IMAGE_HOME." >&2
    echo "Its files are all still there; dotfiles laid out for the old path are not." >&2
}

launch() {
    local name="$1" headless="${2:-0}" ssh_port="${3:-}" image="${4:-}" pull="${5:-0}"
    local home offset=0 running ref digest state tunnel_log

    home="$(sandbox_home_path "$name")"
    mkdir -p "$home"

    if [ -n "$image" ]; then
        if ! valid_image_ref "$image"; then
            echo "Invalid image ref: '$image'." >&2
            return 2
        fi
        sandbox_set_image "$name" "$image"
    fi

    if [ -n "$ssh_port" ]; then
        sandbox_set_ssh_port "$name" "$ssh_port"
    fi

    resolve_image "$name" "$pull" || return 1
    warn_moved_home "$name"

    if running="$(sandbox_running_image "$name")"; then
        ref="$(printf '%s\n' "$running" | sed -n 1p)"
        digest="$(printf '%s\n' "$running" | sed -n 2p)"
        state="$(printf '%s\n' "$running" | sed -n 3p)"
    else
        ref="" digest="" state=""
    fi

    if [ "$state" = "running" ]; then
        if [ -n "$ssh_port" ]; then
            echo "'$name' is already running; port $ssh_port serves it once it next starts."
        fi
        if same_image "$ref" "$digest"; then
            if [ "$headless" = 1 ]; then
                echo "'$name' is already running. Attach a shell with: sandbox $name"
                report_ssh "$name"
                return 0
            fi
            attach "$name"
            return 0
        fi
        echo "'$name' is running on an older $ref, and the image has changed since." >&2
        if ! confirm "Restart '$name' on the new image? Everything running inside it is lost."; then
            [ "$headless" = 1 ] || attach "$name"
            return 0
        fi
        container stop "$name" >/dev/null 2>&1 || true
    fi

    container delete --force "$name" >/dev/null 2>&1 || true

    tunnel_log="$(sandbox_config "$CONFIG" image tunnel_log "")"
    if [ -n "$tunnel_log" ]; then
        offset="$(sandbox_file_size "$home/$tunnel_log")"
        offset="${offset:-0}"
    fi

    start_container "$name" "$home"

    if [ "$headless" = 1 ]; then
        echo "'$name' is running. Attach a shell with: sandbox $name"
        report_ssh "$name"
        report_tunnel "$name" "$offset"
        return 0
    fi

    attach "$name"
}

same_image() {
    local ref="$1" digest="$2"
    if [ -n "$digest" ] && [ -n "$IMAGE_DIGEST" ]; then
        [ "$digest" = "$IMAGE_DIGEST" ]
        return
    fi
    [ "$ref" = "$IMAGE_REF" ]
}

create_and_launch() {
    local name="$1"
    shift
    if ! validate_name "$name"; then
        echo "Invalid name: '$name' (use letters, digits, '-', '_'; no leading dot)." >&2
        return 1
    fi
    launch "$name" "$@"
}

remove_container() {
    container stop "$1" >/dev/null 2>&1 || true
    container delete --force "$1" >/dev/null 2>&1 || true
}

stop_sandbox() {
    local name
    name="$(list_sandboxes | gum choose --header 'Stop which sandbox?')" || return 0
    [ -n "$name" ] || return 0
    container stop "$name" >/dev/null 2>&1 || true
    echo "Stopped '$name'. Its home dir and everything in it are kept."
}

delete_sandbox() {
    local name
    name="$(list_sandboxes | gum choose --header "Delete which sandbox's container?")" || return 0
    [ -n "$name" ] || return 0
    gum confirm "Delete the '$name' container? Its home dir ($(sandbox_home_path "$name")) is kept." || return 0
    remove_container "$name"
    echo "Deleted the '$name' container. Launch '$name' again to recreate it."
}

rename_sandbox() {
    local old new
    old="$(list_sandboxes | gum choose --header 'Rename which sandbox?')" || return 0
    [ -n "$old" ] || return 0
    new="$(gum input --prompt "Rename '$old' to: " --placeholder 'new-name')" || return 0
    [ -n "$new" ] || return 0
    if ! validate_name "$new"; then
        echo "Invalid name: '$new' (use letters, digits, '-', '_'; no leading dot)." >&2
        return 1
    fi
    if [ -e "$(sandbox_home_path "$new")" ]; then
        echo "'$new' already exists." >&2
        return 1
    fi
    remove_container "$old"
    mv "$(sandbox_home_path "$old")" "$(sandbox_home_path "$new")"
    echo "Renamed '$old' -> '$new'."
}

main() {
    local headless=0 ssh_port="" image="" pull=0
    while [ "$#" -gt 0 ]; do
        case "$1" in
            -h|--help) usage; return 0 ;;
            -d|--headless) headless=1; shift ;;
            --pull) pull=1; shift ;;
            --image)
                shift
                image="${1:-}"
                if ! valid_image_ref "$image"; then
                    echo "Invalid image ref: '$image'." >&2
                    return 2
                fi
                shift ;;
            --ssh-port)
                shift
                ssh_port="${1:-}"
                if ! valid_port "$ssh_port"; then
                    echo "Invalid port: '$ssh_port' (use 1-65535)." >&2
                    return 2
                fi
                shift ;;
            -*)
                echo "Unknown option: '$1'." >&2
                usage >&2
                return 2 ;;
            *) break ;;
        esac
    done

    case "${1:-}" in
        "") ;;
        *) create_and_launch "$1" "$headless" "$ssh_port" "$image" "$pull"; return $? ;;
    esac

    ensure_gum || return 1

    local names choice
    local NEW="＋ New sandbox" STOP="⏹ Stop…" REN="✎ Rename…" DEL="🗑 Delete container…"
    names="$(list_sandboxes)"
    choice="$(printf '%s\n' "$names" "$NEW" "$STOP" "$REN" "$DEL" | sed '/^$/d' | gum choose --header 'Sandbox:')" || return 0

    case "$choice" in
        "$NEW")
            local name
            name="$(gum input --prompt 'Name: ' --placeholder 'e.g. myproject')" || return 0
            create_and_launch "$name" "$headless" "$ssh_port" "$image" "$pull" ;;
        "$STOP") stop_sandbox ;;
        "$REN") rename_sandbox ;;
        "$DEL") delete_sandbox ;;
        *) launch "$choice" "$headless" "$ssh_port" "$image" "$pull" ;;
    esac
}

main "$@"
