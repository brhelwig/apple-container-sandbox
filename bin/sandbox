#!/usr/bin/env bash
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
. "$REPO/bin/lib.sh"

USERNAME="${SANDBOX_USER:-${USER:-dev}}"

usage() {
    cat <<EOF
sandbox — ad-hoc Linux sandboxes on Apple Container

  sandbox              Open the menu (launch, or create/rename/delete).
  sandbox <name>       Launch <name> (offers to create it if new).
  sandbox -d <name>    Launch <name> headless: no terminal, no zellij session.
  sandbox --help       This help.

A headless sandbox runs detached, with the VS Code tunnel and the cluster up, so
you can close the terminal and open it from VS Code. Attach a shell to one at any
time with \`sandbox <name>\`, and stop it from the menu or with
\`container stop <name>\`.

Homes live under \$SANDBOX_HOMES (default ~/Sandboxes). The container mounts
only its home dir; drop files into ~/Sandboxes/<name> in Finder.
EOF
}

run_container() {
    local name="$1" home="$2"
    shift 2

    local -a resource_args=()
    while IFS= read -r line; do resource_args+=("$line"); done \
        < <(sandbox_resource_args "$REPO/config.toml")

    container run --rm \
        --name "$name" \
        --volume "$home:/home/$USERNAME" \
        ${resource_args[@]+"${resource_args[@]}"} \
        --cap-add ALL \
        "$@"
}

report_tunnel() {
    local name="$1" waited=0
    while [ "$waited" -lt "${SANDBOX_TUNNEL_WAIT:-30}" ]; do
        container exec "$name" /usr/local/bin/sandbox-code status >/dev/null 2>&1 && break
        sleep 2
        waited=$((waited + 2))
    done
    container exec "$name" /usr/local/bin/sandbox-code status || true
}

launch() {
    local name="$1" headless="${2:-0}" home image running_image
    home="$(sandbox_home_path "$name")"
    mkdir -p "$home"

    image="$(bash "$REPO/bin/sandbox-build" | tail -1)"

    running_image="$(container ls 2>/dev/null | awk -v n="$name" '$1 == n {print $2}')"

    if [ -n "$running_image" ]; then
        if [ "$running_image" = "$image" ]; then
            if [ "$headless" = 1 ]; then
                echo "'$name' is already running. Attach with: sandbox $name"
                report_tunnel "$name"
                return 0
            fi
            exec container exec --interactive --tty "$name" /usr/local/bin/sandbox-zellij
        fi
        container stop "$name" >/dev/null 2>&1 || true
    fi

    container delete --force "$name" >/dev/null 2>&1 || true

    if [ "$headless" = 1 ]; then
        run_container "$name" "$home" --detach "$image" \
            /usr/local/bin/sandbox-idle >/dev/null
        echo "'$name' is running headless. Attach a shell with: sandbox $name"
        report_tunnel "$name"
        return 0
    fi

    run_container "$name" "$home" --interactive --tty "$image"
}

create_and_launch() {
    local name="$1" headless="${2:-0}"
    if ! validate_name "$name"; then
        echo "Invalid name: '$name' (use letters, digits, '-', '_'; no leading dot)." >&2
        return 1
    fi
    launch "$name" "$headless"
}

remove_container() {
    container stop "$1" >/dev/null 2>&1 || true
    container delete --force "$1" >/dev/null 2>&1 || true
}

delete_sandbox() {
    local name
    name="$(list_sandboxes | gum choose --header "Delete which sandbox's container?")" || return 0
    [ -n "$name" ] || return 0
    gum confirm "Delete the '$name' container? Its home dir ($(sandbox_home_path "$name")) is kept." || return 0
    remove_container "$name"
    echo "Deleted the '$name' container. Launch '$name' again to recreate it."
}

rename_sandbox() {
    local old new
    old="$(list_sandboxes | gum choose --header 'Rename which sandbox?')" || return 0
    [ -n "$old" ] || return 0
    new="$(gum input --prompt "Rename '$old' to: " --placeholder 'new-name')" || return 0
    [ -n "$new" ] || return 0
    if ! validate_name "$new"; then
        echo "Invalid name: '$new' (use letters, digits, '-', '_'; no leading dot)." >&2
        return 1
    fi
    if [ -e "$(sandbox_home_path "$new")" ]; then
        echo "'$new' already exists." >&2
        return 1
    fi
    remove_container "$old"
    mv "$(sandbox_home_path "$old")" "$(sandbox_home_path "$new")"
    echo "Renamed '$old' -> '$new'."
}

main() {
    local headless=0
    case "${1:-}" in
        -h|--help) usage; return 0 ;;
        -d|--headless) headless=1; shift ;;
    esac

    case "${1:-}" in
        "") ;;
        -*)
            echo "Unknown option: '$1'." >&2
            usage >&2
            return 2 ;;
        *) create_and_launch "$1" "$headless"; return $? ;;
    esac

    ensure_gum || return 1

    local names choice
    local NEW="＋ New sandbox" REN="✎ Rename…" DEL="🗑 Delete container…"
    names="$(list_sandboxes)"
    choice="$(printf '%s\n' "$names" "$NEW" "$REN" "$DEL" | sed '/^$/d' | gum choose --header 'Sandbox:')" || return 0

    case "$choice" in
        "$NEW")
            local name
            name="$(gum input --prompt 'Name: ' --placeholder 'e.g. myproject')" || return 0
            create_and_launch "$name" "$headless" ;;
        "$REN") rename_sandbox ;;
        "$DEL") delete_sandbox ;;
        *) launch "$choice" "$headless" ;;
    esac
}

main "$@"
