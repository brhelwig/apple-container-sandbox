#!/usr/bin/env bash
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
# shellcheck source=lib.sh
. "$REPO/bin/lib.sh"

USERNAME="${SANDBOX_USER:-${USER:-dev}}"

usage() {
    cat <<EOF
sandbox — ad-hoc Linux sandboxes on Apple Container

  sandbox            Open the menu (launch, or create/rename/delete).
  sandbox <name>     Launch <name> (offers to create it if new).
  sandbox --help     This help.

Homes live under \$SANDBOX_HOMES (default ~/Sandboxes). The container mounts
only its home dir; drop files into ~/Sandboxes/<name> in Finder.
EOF
}

# The home dir persists across recreation, so replacing a stale container
# loses nothing. Every sandbox runs fully privileged, because k3s needs
# CAP_SYS_ADMIN (mount, cgroups) and CAP_NET_ADMIN (iptables, netns), neither of
# which is in Apple Container's default set.
launch() {
    local name="$1" home image running_image
    home="$(sandbox_home_path "$name")"
    mkdir -p "$home"

    image="$(bash "$REPO/bin/sandbox-build" | tail -1)"

    running_image="$(container ls 2>/dev/null | awk -v n="$name" '$1 == n {print $2}')"

    if [ -n "$running_image" ]; then
        if [ "$running_image" = "$image" ]; then
            exec container exec --interactive --tty "$name" /usr/local/bin/sandbox-zellij
        fi
        # Stale image — stop it so the container is recreated on the current one.
        container stop "$name" >/dev/null 2>&1 || true
    fi

    container delete --force "$name" >/dev/null 2>&1 || true

    local -a resource_args=()
    while IFS= read -r line; do resource_args+=("$line"); done \
        < <(sandbox_resource_args "$REPO/config.toml")

    container run --rm --interactive --tty \
        --name "$name" \
        --volume "$home:/home/$USERNAME" \
        ${resource_args[@]+"${resource_args[@]}"} \
        --cap-add ALL \
        "$image"
}

create_and_launch() {
    local name="$1"
    if ! validate_name "$name"; then
        echo "Invalid name: '$name' (use letters, digits, '-', '_'; no leading dot)." >&2
        return 1
    fi
    launch "$name"
}

remove_container() {
    container stop "$1" >/dev/null 2>&1 || true
    container delete --force "$1" >/dev/null 2>&1 || true
}

delete_sandbox() {
    local name
    name="$(list_sandboxes | gum choose --header 'Delete which sandbox?')" || return 0
    [ -n "$name" ] || return 0
    gum confirm "Delete '$name' and its home dir ($(sandbox_home_path "$name"))? Cannot be undone." || return 0
    remove_container "$name"
    rm -rf "$(sandbox_home_path "$name")"
    echo "Deleted sandbox '$name'."
}

rename_sandbox() {
    local old new
    old="$(list_sandboxes | gum choose --header 'Rename which sandbox?')" || return 0
    [ -n "$old" ] || return 0
    new="$(gum input --prompt "Rename '$old' to: " --placeholder 'new-name')" || return 0
    [ -n "$new" ] || return 0
    if ! validate_name "$new"; then
        echo "Invalid name: '$new' (use letters, digits, '-', '_'; no leading dot)." >&2
        return 1
    fi
    if [ -e "$(sandbox_home_path "$new")" ]; then
        echo "'$new' already exists." >&2
        return 1
    fi
    remove_container "$old"
    mv "$(sandbox_home_path "$old")" "$(sandbox_home_path "$new")"
    echo "Renamed '$old' -> '$new'."
}

main() {
    case "${1:-}" in
        -h|--help) usage; return 0 ;;
        "") ;;  # fall through to menu
        *) create_and_launch "$1"; return $? ;;
    esac

    ensure_gum || return 1

    local names choice
    local NEW="＋ New sandbox" REN="✎ Rename…" DEL="🗑 Delete…"
    names="$(list_sandboxes)"
    choice="$(printf '%s\n' "$names" "$NEW" "$REN" "$DEL" | sed '/^$/d' | gum choose --header 'Sandbox:')" || return 0

    case "$choice" in
        "$NEW")
            local name
            name="$(gum input --prompt 'Name: ' --placeholder 'e.g. myproject')" || return 0
            create_and_launch "$name" ;;
        "$REN") rename_sandbox ;;
        "$DEL") delete_sandbox ;;
        *) launch "$choice" ;;
    esac
}

main "$@"
