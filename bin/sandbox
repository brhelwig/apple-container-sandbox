#!/usr/bin/env bash
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
. "$REPO/bin/lib.sh"

CONFIG="$REPO/config.toml"

usage() {
    cat <<EOF
sandbox — ad-hoc Linux sandboxes on Apple Container

  sandbox                    Open the menu (launch, or stop/rename/reset/delete).
  sandbox <name>             Launch <name> and attach a shell to it.
  sandbox -d <name>          Launch <name> without attaching anything.
  sandbox --image <ref>      Run <name> on this image from now on.
  sandbox --pull <name>      Fetch the image again before launching.
  sandbox --ssh-port <port>  Serve <name>'s SSH on this port of the Mac.
  sandbox --help             This help.

Sandboxes run detached and keep running when you leave the shell, so a build
or an agent you start inside one survives closing the terminal. Stop one from
the menu or with \`container stop <name>\`.

Every sandbox runs a published image rather than one built here. It defaults to
$SANDBOX_DEFAULT_IMAGE, and \`[image].ref\` in
config.toml changes that for every sandbox. \`--image\` pins one sandbox to a
ref of its own, recorded in ~/Sandboxes/<name>/.sandbox-image; the menu's
\`Reset image\` entry drops that pin and rebuilds the sandbox on the config ref.

Deleting a sandbox from the menu removes its container and puts
~/Sandboxes/<name> in the Trash, so its files are recoverable until you empty it.

Every sandbox also serves SSH, on a port of the Mac that is its own, so it can
be reached from anywhere that reaches the Mac, a tailnet included. The port is
kept in ~/Sandboxes/<name>/.sandbox-ssh-port and stays the same across launches.
Only a key gets in; there is no password.

Homes live under \$SANDBOX_HOMES (default ~/Sandboxes). The container mounts
only its home dir; drop files into ~/Sandboxes/<name> in Finder.
EOF
}

IMAGE_REF="" IMAGE_HOME="" IMAGE_USER="" IMAGE_SHELL="" IMAGE_DIGEST=""

# Fills the IMAGE_* globals from the image itself, so the mount target, the
# login name and the shell come from the image rather than from this Mac or
# from something you had to write in a config file.
resolve_image() {
    local name="$1" pull="$2" lines cached probed
    IMAGE_REF="$(sandbox_image_ref "$CONFIG" "$name")"

    if ! valid_image_ref "$IMAGE_REF"; then
        echo "Invalid image ref: '$IMAGE_REF'." >&2
        return 2
    fi

    if [ "$pull" = 1 ]; then
        echo "Fetching $IMAGE_REF ..." >&2
        sandbox_image_pull "$IMAGE_REF" >&2 || return 1
    fi

    lines="$(sandbox_image_config "$IMAGE_REF")" || {
        echo "Fetching $IMAGE_REF ..." >&2
        sandbox_image_pull "$IMAGE_REF" >&2 || return 1
        lines="$(sandbox_image_config "$IMAGE_REF")" || {
            echo "Could not read the config of $IMAGE_REF." >&2
            return 1
        }
    }

    IMAGE_HOME="$(printf '%s\n' "$lines" | sed -n 1p)"
    IMAGE_USER="$(printf '%s\n' "$lines" | sed -n 2p)"
    IMAGE_SHELL="$(printf '%s\n' "$lines" | sed -n 3p)"
    IMAGE_DIGEST="$(printf '%s\n' "$lines" | sed -n 5p)"

    if [ -z "$IMAGE_HOME" ] || [ -z "$IMAGE_SHELL" ] || ! usable_name "$IMAGE_USER"; then
        cached="$(sandbox_recorded_facts "$name")"
        if [ "$(printf '%s\n' "$cached" | sed -n 1p)" = "$IMAGE_DIGEST" ]; then
            probed="$(printf '%s\n' "$cached" | sed -n '2,4p')"
        else
            echo "Asking $IMAGE_REF where it keeps its home ..." >&2
            probed="$(sandbox_probe_image "$IMAGE_REF")"
        fi
        [ -n "$IMAGE_HOME" ] || IMAGE_HOME="$(printf '%s\n' "$probed" | sed -n 1p)"
        usable_name "$IMAGE_USER" || IMAGE_USER="$(printf '%s\n' "$probed" | sed -n 2p)"
        [ -n "$IMAGE_SHELL" ] || IMAGE_SHELL="$(printf '%s\n' "$probed" | sed -n 3p)"
    fi

    if [ -z "$IMAGE_HOME" ]; then
        echo "$IMAGE_REF has no home directory to mount '$name' over." >&2
        return 1
    fi

    [ -n "$IMAGE_SHELL" ] || IMAGE_SHELL=/bin/sh
    sandbox_set_facts "$name" "$IMAGE_DIGEST" "$IMAGE_HOME" "$IMAGE_USER" "$IMAGE_SHELL"
    return 0
}

# A uid names no account anyone can ssh to, so it is not a name we can use.
usable_name() {
    case "${1:-}" in
        ""|*[!a-zA-Z0-9._-]*) return 1 ;;
        *[!0-9]*)             return 0 ;;
        *)                    return 1 ;;
    esac
}

run_container() {
    local name="$1" home="$2"
    shift 2

    local -a resource_args=()
    while IFS= read -r line; do resource_args+=("$line"); done \
        < <(sandbox_resource_args "$CONFIG")

    # An image whose entrypoint is tini warns unless it knows it is not PID 1.
    container run --detach --rm \
        --name "$name" \
        --volume "$home:$IMAGE_HOME" \
        ${resource_args[@]+"${resource_args[@]}"} \
        --env TINI_SUBREAPER=1 \
        --cap-add ALL \
        --init \
        "$@"
}

running_now() {
    [ "$(sandbox_running_image "$1" 2>/dev/null | sed -n 3p)" = "running" ]
}

terminfo_for() {
    local name="$1" term="${TERM:-xterm-256color}"

    if container exec "$name" infocmp "$term" >/dev/null 2>&1; then
        printf '%s\n' "$term"
        return
    fi

    if infocmp -x "$term" 2>/dev/null \
        | container exec --interactive "$name" \
            tic -x -o "$IMAGE_HOME/.terminfo" - >/dev/null 2>&1 \
        && container exec "$name" infocmp "$term" >/dev/null 2>&1; then
        printf '%s\n' "$term"
        return
    fi

    echo "'$name' does not know $term, and this Mac cannot describe it. Using xterm-256color." >&2
    printf '%s\n' "xterm-256color"
}

attach() {
    local name="$1"

    container exec --interactive --tty \
        --env "TERM=$(terminfo_for "$name")" \
        "$name" "$IMAGE_SHELL" -l \
        || true

    if running_now "$name"; then
        echo "'$name' is still running. Stop it from the menu, or with: container stop $name"
    else
        echo "'$name' is not running any more." >&2
    fi
}

report_ssh() {
    local name="$1" port count
    sandbox_ssh_enabled "$CONFIG" || { echo "ssh: off in config.toml"; return 0; }
    port="$(sandbox_recorded_ssh_port "$name")"
    count="$(sandbox_authorized_key_count "$name")"
    if [ "$count" -eq 0 ]; then
        echo "ssh: no authorized key, so nothing can log in."
        echo "     add one to $(sandbox_authorized_keys_path "$name")"
        return 0
    fi
    echo "ssh: $count authorized key(s); ssh -p $port $IMAGE_USER@127.0.0.1"
    echo "     the same port on the Mac's own address reaches it from elsewhere"
}

# The log the VS Code CLI writes, in the sandbox home. Absent in an image that
# runs no tunnel, and then this reports nothing.
TUNNEL_LOG=.code-tunnel.log

report_tunnel() {
    local name="$1" offset="$2" log waited=0 url
    log="$(sandbox_home_path "$name")/$TUNNEL_LOG"
    [ -e "$log" ] || return 0

    while [ "$waited" -lt "${SANDBOX_TUNNEL_WAIT:-30}" ]; do
        if url="$(sandbox_tunnel_url "$log" "$offset")"; then
            echo "tunnel: $url"
            return 0
        fi
        sleep 2
        waited=$((waited + 2))
    done
    echo "tunnel: no link yet; the image reports it in ${log##*/}"
}

start_container() {
    local name="$1" home="$2"
    local -a ssh_args=()

    sandbox_seed_home "$name" "$IMAGE_REF" "$IMAGE_HOME"

    if sandbox_ssh_enabled "$CONFIG"; then
        sandbox_seed_authorized_keys "$name"
        ssh_args=(--publish "$(sandbox_ssh_address "$CONFIG"):$(sandbox_ssh_port "$CONFIG" "$name"):22")
    fi

    echo "Launching '$name' on $IMAGE_REF ..." >&2
    # `sleep infinity` is a GNU extension, so spell out a number busybox takes.
    run_container "$name" "$home" ${ssh_args[@]+"${ssh_args[@]}"} \
        "$IMAGE_REF" sleep 2147483647 >/dev/null
}

warn_moved_home() {
    local name="$1" previous="$2"
    [ -n "$previous" ] || return 0
    [ "$previous" != "$IMAGE_HOME" ] || return 0
    echo "'$name' used to mount at $previous and now mounts at $IMAGE_HOME." >&2
    echo "Its files are all still there; dotfiles laid out for the old path are not." >&2
}

launch() {
    local name="$1" headless="${2:-0}" ssh_port="${3:-}" image="${4:-}" pull="${5:-0}"
    local home offset=0 running ref digest state was_home

    home="$(sandbox_home_path "$name")"
    mkdir -p "$home"

    if [ -n "$image" ] && ! valid_image_ref "$image"; then
        echo "Invalid image ref: '$image'." >&2
        return 2
    fi

    if [ -n "$ssh_port" ]; then
        sandbox_set_ssh_port "$name" "$ssh_port"
    fi

    # resolve_image rewrites the facts, so read the old mount point first.
    was_home="$(printf '%s\n' "$(sandbox_recorded_facts "$name")" | sed -n 2p)"

    SANDBOX_IMAGE_OVERRIDE="$image" resolve_image "$name" "$pull" || return 1
    warn_moved_home "$name" "$was_home"

    # Only once the ref has proved itself, so a typo does not silently become
    # the sandbox's permanent image.
    [ -n "$image" ] && sandbox_set_image "$name" "$image"

    if running="$(sandbox_running_image "$name")"; then
        ref="$(printf '%s\n' "$running" | sed -n 1p)"
        digest="$(printf '%s\n' "$running" | sed -n 2p)"
        state="$(printf '%s\n' "$running" | sed -n 3p)"
    else
        ref="" digest="" state=""
    fi

    if [ "$state" = "running" ]; then
        if [ -n "$ssh_port" ]; then
            echo "'$name' is already running; port $ssh_port serves it once it next starts."
        fi
        if same_image "$ref" "$digest"; then
            if [ "$headless" = 1 ]; then
                echo "'$name' is already running. Attach a shell with: sandbox $name"
                report_ssh "$name"
                return 0
            fi
            attach "$name"
            return 0
        fi
        echo "'$name' is running on an older $ref, and the image has changed since." >&2
        if ! confirm "Restart '$name' on the new image? Everything running inside it is lost."; then
            [ "$headless" = 1 ] || attach "$name"
            return 0
        fi
        container stop "$name" >/dev/null 2>&1 || true
    fi

    container delete --force "$name" >/dev/null 2>&1 || true

    offset="$(sandbox_file_size "$home/$TUNNEL_LOG")"
    offset="${offset:-0}"

    start_container "$name" "$home"

    if [ "$headless" = 1 ]; then
        echo "'$name' is running. Attach a shell with: sandbox $name"
        report_ssh "$name"
        report_tunnel "$name" "$offset"
        return 0
    fi

    attach "$name"
}

same_image() {
    local ref="$1" digest="$2"
    if [ -n "$digest" ] && [ -n "$IMAGE_DIGEST" ]; then
        [ "$digest" = "$IMAGE_DIGEST" ]
        return
    fi
    [ "$ref" = "$IMAGE_REF" ]
}

create_and_launch() {
    local name="$1"
    shift
    if ! validate_name "$name"; then
        echo "Invalid name: '$name' (use letters, digits, '-', '_'; no leading dot)." >&2
        return 1
    fi
    launch "$name" "$@"
}

remove_container() {
    container stop "$1" >/dev/null 2>&1 || true
    container delete --force "$1" >/dev/null 2>&1 || true
}

stop_sandbox() {
    local name
    name="$(list_sandboxes | gum choose --header 'Stop which sandbox?')" || return 0
    [ -n "$name" ] || return 0
    container stop "$name" >/dev/null 2>&1 || true
    echo "Stopped '$name'. Its home dir and everything in it are kept."
}

delete_sandbox() {
    local name home
    name="$(list_sandboxes | gum choose --header 'Delete which sandbox?')" || return 0
    [ -n "$name" ] || return 0
    home="$(sandbox_home_path "$name")"
    gum confirm "Delete '$name'? Its container goes, and $home goes to the Trash." || return 0
    remove_container "$name"
    if ! sandbox_trash "$home"; then
        echo "Deleted the '$name' container, but could not move $home to the Trash." >&2
        return 1
    fi
    echo "Deleted '$name'. Its home dir is in the Trash until you empty it."
}

reset_sandbox() {
    local name headless="${1:-0}" ref
    name="$(list_sandboxes | gum choose --header 'Reset which sandbox to the config image?')" || return 0
    [ -n "$name" ] || return 0
    ref="$(sandbox_config "$CONFIG" image ref "$SANDBOX_DEFAULT_IMAGE")"
    gum confirm "Reset '$name' onto $ref? Everything running inside it is lost." || return 0
    rm -f "$(sandbox_image_path "$name")" "$(sandbox_facts_path "$name")"
    remove_container "$name"
    launch "$name" "$headless" "" "" 1
}

rename_sandbox() {
    local old new
    old="$(list_sandboxes | gum choose --header 'Rename which sandbox?')" || return 0
    [ -n "$old" ] || return 0
    new="$(gum input --prompt "Rename '$old' to: " --placeholder 'new-name')" || return 0
    [ -n "$new" ] || return 0
    if ! validate_name "$new"; then
        echo "Invalid name: '$new' (use letters, digits, '-', '_'; no leading dot)." >&2
        return 1
    fi
    if [ -e "$(sandbox_home_path "$new")" ]; then
        echo "'$new' already exists." >&2
        return 1
    fi
    remove_container "$old"
    mv "$(sandbox_home_path "$old")" "$(sandbox_home_path "$new")"
    echo "Renamed '$old' -> '$new'."
}

main() {
    local headless=0 ssh_port="" image="" pull=0
    while [ "$#" -gt 0 ]; do
        case "$1" in
            -h|--help) usage; return 0 ;;
            -d|--headless) headless=1; shift ;;
            --pull) pull=1; shift ;;
            --image)
                shift
                image="${1:-}"
                if ! valid_image_ref "$image"; then
                    echo "Invalid image ref: '$image'." >&2
                    return 2
                fi
                shift ;;
            --ssh-port)
                shift
                ssh_port="${1:-}"
                if ! valid_port "$ssh_port"; then
                    echo "Invalid port: '$ssh_port' (use 1-65535)." >&2
                    return 2
                fi
                shift ;;
            -*)
                echo "Unknown option: '$1'." >&2
                usage >&2
                return 2 ;;
            *) break ;;
        esac
    done

    case "${1:-}" in
        "") ;;
        *) create_and_launch "$1" "$headless" "$ssh_port" "$image" "$pull"; return $? ;;
    esac

    ensure_gum || return 1

    local names choice
    local NEW="＋ New sandbox" STOP="⏹ Stop…" REN="✎ Rename…"
    local RESET="↺ Reset image…" DEL="🗑 Delete…"
    names="$(list_sandboxes)"
    choice="$(printf '%s\n' "$names" "$NEW" "$STOP" "$REN" "$RESET" "$DEL" | sed '/^$/d' | gum choose --header 'Sandbox:')" || return 0

    case "$choice" in
        "$NEW")
            local name
            name="$(gum input --prompt 'Name: ' --placeholder 'e.g. myproject')" || return 0
            create_and_launch "$name" "$headless" "$ssh_port" "$image" "$pull" ;;
        "$STOP") stop_sandbox ;;
        "$REN") rename_sandbox ;;
        "$RESET") reset_sandbox "$headless" ;;
        "$DEL") delete_sandbox ;;
        *) launch "$choice" "$headless" "$ssh_port" "$image" "$pull" ;;
    esac
}

main "$@"
