#!/usr/bin/env bash
set -euo pipefail

MARKER="${SANDBOX_WELCOME_MARKER:-/tmp/.sandbox-welcomed}"

if [ -e "$MARKER" ]; then
    exit 0
fi
: > "$MARKER"

if [ -t 1 ]; then
    dim=$'\033[2m'
    bold=$'\033[1m'
    off=$'\033[0m'
else
    dim="" bold="" off=""
fi

printf '\n  %sWelcome.%s Run %sman sandbox%s for what is installed here.\n\n' \
    "$dim" "$off" "$bold" "$off"
