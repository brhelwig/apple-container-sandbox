#!/usr/bin/env bash
# Assemble the sandbox kubeconfig. Re-runnable by hand as `sandbox-kubeconfig`.
#
# kubectl takes a lock before writing a kubeconfig by creating "<file>.lock"
# with mode 000, and virtiofs — the filesystem behind the bind-mounted sandbox
# home — refuses to create a file with no permission bits. So every `kubectl
# config` write against a file under $HOME fails with EACCES and strands a lock
# file that then breaks later reads.
#
# KUBECONFIG therefore points into a shim dir on the container filesystem, where
# the lock can be taken. Its `config` entry is a symlink, so the kubeconfig
# itself is still written through to the home dir and survives the container.
# gcloud writes kubeconfigs without locking, so it works either way.
set -euo pipefail

# Overridable so this can be tested outside a container.
SHIM_DIR="${SANDBOX_KUBE_DIR:-/var/lib/sandbox/kube}"
K3S_SRC="${SANDBOX_K3S_KUBECONFIG:-/etc/rancher/k3s/k3s.yaml}"
CONFIG="$HOME/.kube/config"

mkdir -p "$SHIM_DIR" "$(dirname "$CONFIG")"

# Repair a home left holding the symlink an earlier version dropped here: it
# carries no data of its own, and it can't be written to or merged from.
if [ -L "$CONFIG" ] && [ "$(readlink "$CONFIG")" = "$K3S_SRC" ]; then
    rm -f "$CONFIG"
fi

# Only ever seed a missing kubeconfig — never touch one that already exists.
# kubectl writes new contexts to the first file in KUBECONFIG that exists, so
# without this, credentials would land in the cluster entry below and be lost
# the next time it is regenerated.
if [ ! -e "$CONFIG" ] && [ ! -L "$CONFIG" ]; then
    printf 'apiVersion: v1\nkind: Config\nclusters: []\ncontexts: []\nusers: []\npreferences: {}\n' \
        > "$CONFIG"
    chmod 600 "$CONFIG"
fi

ln -sfn "$CONFIG" "$SHIM_DIR/config"

# The local cluster, when one is running. k3s names its context, its cluster and
# its user all "default", which would collide with anything already called that
# in the kubeconfig above — first file wins on a merge, so a stale entry would
# quietly shadow the live cluster. Rename them, and keep the copy in the shim
# dir so the cluster's own file stays root-owned and read-only.
if [ -s "$K3S_SRC" ]; then
    sed 's/: default$/: k3s/' "$K3S_SRC" > "$SHIM_DIR/k3s.yaml.tmp"
    chmod 600 "$SHIM_DIR/k3s.yaml.tmp"
    mv "$SHIM_DIR/k3s.yaml.tmp" "$SHIM_DIR/k3s.yaml"
fi
