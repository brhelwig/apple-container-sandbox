#!/usr/bin/env bash
set -euo pipefail

SHIM_DIR="${SANDBOX_KUBE_DIR:-/var/lib/sandbox/kube}"
K3S_SRC="${SANDBOX_K3S_KUBECONFIG:-/etc/rancher/k3s/k3s.yaml}"
CONFIG="$HOME/.kube/config"

mkdir -p "$SHIM_DIR" "$(dirname "$CONFIG")"

if [ ! -e "$CONFIG" ] && [ ! -L "$CONFIG" ]; then
    printf 'apiVersion: v1\nkind: Config\nclusters: []\ncontexts: []\nusers: []\npreferences: {}\n' \
        > "$CONFIG"
    chmod 600 "$CONFIG"
fi

ln -sfn "$CONFIG" "$SHIM_DIR/config"

if [ -s "$K3S_SRC" ]; then
    sed 's/: default$/: k3s/' "$K3S_SRC" > "$SHIM_DIR/k3s.yaml.tmp"
    chmod 600 "$SHIM_DIR/k3s.yaml.tmp"
    mv "$SHIM_DIR/k3s.yaml.tmp" "$SHIM_DIR/k3s.yaml"
fi
