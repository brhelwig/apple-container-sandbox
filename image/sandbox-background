#!/bin/sh
set -eu

usage() {
    cat <<'EOF'
Run a command as background work: niced, idle I/O, first in line for the OOM
killer. Everything the command starts inherits all three.

  sandbox-background <command> [args...]
EOF
}

if [ "$#" -eq 0 ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    usage
    [ "$#" -eq 0 ] && exit 2
    exit 0
fi

# shellcheck source=sandbox-nice.sh
. "${SANDBOX_NICE:-/etc/sandbox-nice.sh}"
# Set on this process, which then becomes the command, so the command carries
# them from its first instruction.
sandbox_deprioritize
exec "$@"
