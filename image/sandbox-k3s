#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'EOF'
Bring a single-node k3s cluster up or down inside a sandbox.

  sandbox-k3s up | down | status | enabled

Cluster state lives on a sparse ext4 image in $HOME, loop-mounted at
/var/lib/rancher, and survives the container.
EOF
}

CONFIG="${SANDBOX_K3S_CONFIG:-/etc/sandbox-config.toml}"
# Not the home dir: that is virtiofs, where mknod is denied, so the overlayfs
# whiteouts containerd's snapshotter needs to delete a file from a lower layer
# are impossible.
STATE_DIR=/var/lib/rancher
LOG=/var/log/k3s.log
BRIDGE=br-k3s
# Anchored so it cannot match this script's own argv.
K3S_PATTERN='^/usr/local/bin/k3s server'

# shellcheck source=sandbox-config.sh
. "${SANDBOX_CONFIG_LIB:-/etc/sandbox-config.sh}"

cfg() { sandbox_config "$CONFIG" k3s "$1" "$2"; }

# sudo's default env_reset would hand us root's home after the re-exec in main.
sandbox_home() {
    local user home
    user="${SUDO_USER:-$(id -un)}"
    home="$(getent passwd "$user" | cut -d: -f6)"
    printf '%s\n' "${home:-$HOME}"
}

disk_img()  { printf '%s/.sandbox-k3s.img\n' "$(sandbox_home)"; }
running()   { pgrep -f "$K3S_PATTERN" >/dev/null 2>&1; }

disk_loop() { losetup -j "$(disk_img)" 2>/dev/null | head -1 | cut -d: -f1; }

enabled() { [ "$(cfg enabled false)" = "true" ]; }

mount_state() {
    local img loop
    img="$(disk_img)"
    findmnt -rno TARGET "$STATE_DIR" >/dev/null 2>&1 && return 0
    if [ ! -f "$img" ]; then
        echo "creating $(cfg disk 8G) cluster disk at $img (sparse)"
        truncate -s "$(cfg disk 8G)" "$img"
        mkfs.ext4 -q -F "$img"
    fi
    mkdir -p "$STATE_DIR"
    # Reuse the existing device if the disk is already attached — a previous
    # `down` may still be releasing it — so one file never gets two loops.
    loop="$(disk_loop)"
    [ -n "$loop" ] || loop="$(losetup --find --show "$img")"
    mount "$loop" "$STATE_DIR"
}

# /proc/sys ships read-only, but k3s requires IP forwarding.
prepare_kernel() {
    mount -o remount,rw /proc/sys 2>/dev/null || true
    sysctl -qw net.ipv4.ip_forward=1
    sysctl -qw net.ipv6.conf.all.forwarding=1 2>/dev/null || true
}

# kubelet creates /sys/fs/cgroup/kubepods and needs domain controllers there.
# cgroup v2 forbids that while the root cgroup holds processes of its own, so
# move them into a child first, then delegate. Without this kubelet dies with
# "cannot enter cgroupv2 ... invalid state".
prepare_cgroups() {
    local type procs pid
    type="$(cat /sys/fs/cgroup/cgroup.type 2>/dev/null || echo domain)"
    if [ "$type" = "domain threaded" ]; then
        echo "error: the root cgroup is 'domain threaded', which the kernel" >&2
        echo "cannot convert back to a resource domain. Recreate the sandbox" >&2
        echo "container to clear it — the cluster disk is preserved." >&2
        return 1
    fi
    mkdir -p /sys/fs/cgroup/init
    procs="$(cat /sys/fs/cgroup/cgroup.procs)"
    for pid in $procs; do
        printf '%s\n' "$pid" > /sys/fs/cgroup/init/cgroup.procs 2>/dev/null || true
    done
    if ! printf '%s\n' '+cpuset +cpu +io +memory +hugetlb +pids' \
            > /sys/fs/cgroup/cgroup.subtree_control 2>/dev/null; then
        echo "error: cannot delegate cgroup controllers to kubelet." >&2
        echo "The sandbox is most likely missing CAP_SYS_ADMIN — check that" >&2
        echo "[k3s].enabled is set in config.toml and relaunch the sandbox." >&2
        return 1
    fi
}

# The node needs a fixed address. Apple Container issues a new DHCP lease every
# time a container is recreated, but persisted cluster state pins the node IP —
# a changed address makes k3s refuse to start networking ("failed to find
# interface with specified node ip").
prepare_network() {
    ip link show "$BRIDGE" >/dev/null 2>&1 && return 0
    ip link add "$BRIDGE" type bridge
    ip addr add "$(cfg node_ip 10.99.0.1)/24" dev "$BRIDGE"
    ip link set "$BRIDGE" up
}

# Add the cluster to the sandbox kubeconfig once k3s has written its own. The
# server writes that file some seconds after it starts, and `up` deliberately
# returns before then, so wait for it in the background rather than holding up
# the shell. Runs as the sandbox user, so anything it creates in the home stays
# owned by them.
publish_kubeconfig() {
    local user home
    user="${SUDO_USER:-$(id -un)}"
    home="$(sandbox_home)"
    [ -n "$home" ] && [ -d "$home" ] || return 0
    (
        for _ in $(seq 1 120); do
            [ -s /etc/rancher/k3s/k3s.yaml ] && break
            sleep 1
        done
        sudo -u "$user" env HOME="$home" /usr/local/bin/sandbox-kubeconfig
    ) >/dev/null 2>&1 &
}

# Overrule the OOM score kubelet gives itself. It sets -999 as the agent starts,
# which would make the cluster the last thing the kernel kills instead of the
# first — the sandbox should lose its cluster before it loses the session it is
# being used from. Waits for that value rather than racing it, since a write
# before kubelet's is simply lost. The containers keep the scores kubelet
# computes for them from their quality of service class, which this does not
# reach.
deprioritize_server() {
    (
        local pid adj
        for _ in $(seq 1 180); do
            pid="$(pgrep -f "$K3S_PATTERN" | head -1)"
            if [ -n "$pid" ]; then
                adj="$(cat "/proc/$pid/oom_score_adj" 2>/dev/null || echo 0)"
                [ "$adj" -lt 0 ] && break
            fi
            sleep 1
        done
        [ -n "${pid:-}" ] && echo 1000 > "/proc/$pid/oom_score_adj"
    ) >/dev/null 2>&1 &
}

up() {
    if running; then echo "k3s is already running"; return 0; fi
    mount_state
    prepare_kernel
    prepare_cgroups
    prepare_network
    [ -s /etc/machine-id ] || tr -d '-' < /proc/sys/kernel/random/uuid > /etc/machine-id
    publish_kubeconfig
    # sandbox-background execs, so the argv K3S_PATTERN matches is unchanged.
    setsid nohup /usr/local/bin/sandbox-background /usr/local/bin/k3s server \
        --write-kubeconfig-mode 644 \
        --node-ip "$(cfg node_ip 10.99.0.1)" \
        --flannel-iface "$BRIDGE" \
        >> "$LOG" 2>&1 < /dev/null &
    deprioritize_server
    echo "k3s starting in the background; watch it with: sandbox-k3s status"
}

down() {
    local img loop waited=0
    pkill -f "$K3S_PATTERN" 2>/dev/null || true
    pkill -f 'containerd-shim' 2>/dev/null || true
    while running && [ "$waited" -lt 20 ]; do sleep 1; waited=$((waited + 1)); done
    # k3s leaves many mounts under the state dir; clear them deepest-first so
    # the loop device can be released.
    # `|| true`: with pipefail, grep matching nothing (no cluster ever started)
    # would otherwise abort before the state dir is unmounted.
    awk '{print $2}' /proc/mounts \
        | grep -E '^/(var/lib/(rancher|kubelet)|run/(k3s|netns))' \
        | sort -r \
        | while read -r m; do umount "$m" 2>/dev/null || umount -l "$m" 2>/dev/null || true; done || true
    # Prefer a real unmount; a lazy one leaves the loop device busy.
    umount "$STATE_DIR" 2>/dev/null || umount -l "$STATE_DIR" 2>/dev/null || true
    img="$(disk_img)"
    # Detaching can be deferred while the unmount settles, so retry briefly.
    waited=0
    while [ -n "$(disk_loop)" ] && [ "$waited" -lt 5 ]; do
        losetup -d "$(disk_loop)" 2>/dev/null || true
        [ -n "$(disk_loop)" ] || break
        sleep 1
        waited=$((waited + 1))
    done
    echo "k3s stopped; cluster state kept in $img"
}

status() {
    if ! running; then
        echo "k3s: not running"
        return 1
    fi
    echo "k3s: running"
    findmnt -rno SIZE,USED,TARGET "$STATE_DIR" 2>/dev/null | sed 's/^/disk: /' || true
    if ! /usr/local/bin/k3s kubectl get nodes 2>/dev/null; then
        echo "API server not ready yet — see $LOG"
        return 0
    fi
    /usr/local/bin/k3s kubectl get pods -A 2>/dev/null || true
}

main() {
    local cmd="${1:-status}"
    case "$cmd" in
        enabled) enabled && return 0 || return 1 ;;
        up|down|status) ;;
        -h|--help) usage; return 0 ;;
        *)
            echo "usage: sandbox-k3s [up|down|status|enabled]" >&2
            return 2 ;;
    esac

    if [ "$(id -u)" -ne 0 ]; then
        exec sudo "$0" "$cmd"
    fi
    "$cmd"
}

main "$@"
