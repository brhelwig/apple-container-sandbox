#!/usr/bin/env python3
import sys
import tomllib

REPO = "https://github.com/brhelwig/apple-container-sandbox"


def roff(text):
    text = str(text).replace("\\", "\\e").replace("-", "\\-")
    if text[:1] in (".", "'"):
        text = "\\&" + text
    return text


def joined(values):
    return ", ".join(roff(v) for v in values) if values else "None."


def argument(index):
    return sys.argv[index].split() if len(sys.argv) > index else []


def merged(base, added):
    return sorted(set(base) | set(added))


def main():
    config_path = sys.argv[1]
    base_packages = argument(2)
    with open(config_path, "rb") as f:
        config = tomllib.load(f)

    brew = config.get("brew", {})
    apt = merged(argument(3), config.get("apt", {}).get("packages", []))
    taps = merged(argument(4), brew.get("taps", []))
    formulae = merged(argument(5), brew.get("formulae", []))
    casks = merged(argument(6), brew.get("casks", []))
    commands = config.get("post_install", {}).get("commands", [])

    resources = config.get("resources", {})
    memory = resources.get("memory")
    cpus = resources.get("cpus")

    k3s = config.get("k3s", {})
    k3s_autostart = bool(k3s.get("autostart", False))
    k3s_disk = k3s.get("disk", "8G")
    k3s_node_ip = k3s.get("node_ip", "10.99.0.1")

    out = []
    add = out.append

    add('.TH SANDBOX 7 "" "apple\\-container\\-sandbox" "Sandbox Manual"')

    add(".SH NAME")
    add("sandbox \\- the Linux sandbox you are in, and what you can do in it")

    add(".SH DESCRIPTION")
    add(
        "This is a sandbox built by apple\\-container\\-sandbox: a Debian container "
        "that runs as a lightweight Linux virtual machine on macOS."
    )
    add(".PP")
    add(
        "The home directory is a bind mount from the Mac, at ~/Sandboxes/<name>, "
        "and it is the only path the two share. Everything outside the home "
        "belongs to the container. The sandbox name is the hostname, the zellij "
        "session name, and the name in the prompt."
    )

    add(".SH WHAT PERSISTS")
    add(
        "The home directory persists. It survives container recreation and image "
        "rebuilds, so shell history, credentials, and anything under the home "
        "stay where they are."
    )
    add(".PP")
    add(
        "Nothing else persists. A package installed by hand is gone the next time "
        "the image is rebuilt. To keep a tool, add it to config.toml on the Mac "
        "and relaunch. See CHANGING WHAT IS INSTALLED below."
    )

    add(".SH YOUR SESSION")
    add(
        "A launch attaches you to a zellij session named after the sandbox. "
        "Detach with Ctrl\\-o, then d. The session and everything in it keeps "
        "running."
    )
    add(".PP")
    add(
        "Attach again with sandbox <name> on the Mac, or with sandbox\\-zellij "
        "inside the sandbox."
    )

    add(".SH VS CODE")
    add(
        "sandbox\\-code runs this sandbox as a VS Code Remote Tunnel. You can then "
        "open the sandbox in VS Code from any machine signed in to the same "
        "account. The tunnel dials out, so nothing listens inside the sandbox and "
        "no port is published on the Mac."
    )

    add(".SS Sign in, once")
    add(".IP 1. 4")
    add(
        "Run sandbox\\-code login. Choose GitHub or Microsoft at the prompt, or "
        "pass \\-\\-provider github to skip it."
    )
    add(".IP 2. 4")
    add("Open the URL it prints, and enter the code it prints.")
    add(".IP 3. 4")
    add("Run sandbox\\-code up to start the tunnel.")
    add(".IP 4. 4")
    add("Run sandbox\\-code status. It prints the link that opens the sandbox.")
    add(".PP")
    add(
        "The sign\\-in and the downloaded server live under ~/.vscode, in the "
        "sandbox home, so they survive container recreation and image rebuilds. "
        "Every later launch starts the tunnel for you."
    )

    add(".SS Open the sandbox")
    add(
        "Open the link from sandbox\\-code status in a browser. Or start VS Code "
        "on any machine, sign in to the same account, and open Remote Explorer. "
        "The tunnel is under Tunnels, named after the sandbox."
    )
    add(".PP")
    add(
        "sandbox\\-code down stops the tunnel and keeps the sign\\-in. The log is "
        "~/.sandbox\\-code.log."
    )

    add(".SH KUBERNETES")
    add(
        "k3s is installed in every sandbox. "
        + (
            "The cluster starts at launch, because [k3s].autostart is on."
            if k3s_autostart
            else "The cluster does not start at launch."
        )
    )
    add(".PP")
    add(
        "Start it with sandbox\\-k3s up. It comes up in the background, and the "
        "API server takes a moment to answer. Watch it with sandbox\\-k3s status, "
        "which prints the nodes and the pods. Stop it with sandbox\\-k3s down. "
        "The log is /var/log/k3s.log."
    )
    add(".PP")
    add(
        "kubectl needs no setup. KUBECONFIG names two files: your own "
        "~/.kube/config, and the cluster's, which sandbox\\-kubeconfig writes. "
        "The cluster context is called k3s. Select it with kubectl config "
        "use\\-context k3s."
    )
    add(".PP")
    add(
        "Cluster state lives on a sparse "
        + roff(k3s_disk)
        + " disk image at ~/.sandbox\\-k3s.img, and it survives the container. "
        "The node address is "
        + roff(k3s_node_ip)
        + ". The sandbox runs with the full capability set, which k3s needs."
    )

    add(".SH CONTAINERS")
    add(
        "podman runs containers inside the sandbox. It runs rootful, through "
        "sudo. An image name with no registry resolves against docker.io."
    )

    add(".SH HEADLESS")
    add(
        "A sandbox can run with no terminal attached. On the Mac, launch it with "
        "sandbox \\-d <name>: the container runs detached, the cluster and the "
        "tunnel start as they always do, and the launcher prints where the "
        "tunnel stands and then returns. Close the terminal and open the sandbox "
        "from VS Code."
    )
    add(".PP")
    add(
        "sandbox <name> attaches a shell to a headless sandbox at any time, and "
        "leaving that shell does not stop it. To stop it, delete the container "
        "from the sandbox menu, or run container stop <name> on the Mac. The home "
        "directory is kept either way."
    )

    add(".SH BACKGROUND WORK")
    add(
        "A command that Claude Code runs is niced to 10, put in the idle I/O "
        "class, and made the first thing the kernel kills when the sandbox runs "
        "out of memory. Claude spawns each command in its own shell, and that "
        "shell applies all three to itself before the command starts, so "
        "everything under it inherits them. A shell you type in is untouched, "
        "and so are claude and zellij: a command that goes wrong loses one "
        "command rather than the session."
    )
    add(".PP")
    add(
        "Run anything else that way with sandbox\\-background <command>. The "
        "cluster already runs that way, so k3s and its workloads are niced and "
        "in the idle I/O class. Each container keeps the OOM score kubelet "
        "computes for it."
    )

    add(".SH RESOURCE LIMITS")
    add("The Mac sets these from [resources] in config.toml.")
    add(".TP")
    add("Memory")
    add(roff(memory) if memory else "Not set. The container default applies.")
    add(".TP")
    add("CPUs")
    add(roff(cpus) if cpus else "Not set. The container default applies.")

    add(".SH COMMANDS")
    add(".TP")
    add("sandbox\\-zellij")
    add("Attach to the zellij session named after the sandbox, or start it.")
    add(".TP")
    add("sandbox\\-code login | up | down | status")
    add("The VS Code tunnel. See VS CODE above.")
    add(".TP")
    add("sandbox\\-k3s up | down | status")
    add("The single\\-node Kubernetes cluster. See KUBERNETES above.")
    add(".TP")
    add("sandbox\\-kubeconfig")
    add(
        "Rebuild the kubeconfig that KUBECONFIG points at. It lives outside "
        "the home so that kubectl can take its lock file; writes still land in "
        "the home and persist."
    )
    add(".TP")
    add("sandbox\\-background <command>")
    add("Run a command as background work. See BACKGROUND WORK above.")
    add(".TP")
    add("sandbox\\-idle")
    add(
        "Hold a headless sandbox open. A headless launch runs this in place of a "
        "zellij session. See HEADLESS above."
    )
    add(".TP")
    add("sandbox\\-setup")
    add("Per\\-launch setup for this sandbox. Runs at launch; re\\-runnable by hand.")
    add(".TP")
    add("podman")
    add("Containers inside the sandbox. See CONTAINERS above.")

    add(".SH INSTALLED TOOLS")
    add(
        "Every sandbox gets the same base set from the image build. config.toml "
        "on the Mac adds to that set. The lists below are what this image has, "
        "from both."
    )

    add(".SS Base toolchain")
    add(joined(sorted(base_packages)))

    add(".SS Debian packages (apt)")
    add(joined(apt))

    add(".SS Homebrew taps")
    add(joined(taps))

    add(".SS Homebrew formulae")
    add(joined(formulae))

    add(".SS Homebrew casks")
    add(joined(casks))

    add(".SS Commands run after the installs")
    if commands:
        add(".nf")
        for command in commands:
            add(roff(command))
        add(".fi")
    else:
        add("None.")

    add(".SH CHANGING WHAT IS INSTALLED")
    add(
        "config.toml lives on the Mac, in the apple\\-container\\-sandbox checkout, "
        "not in the sandbox. Add a package to it and run sandbox <name> again: the "
        "image rebuilds, the container is recreated on it, and the home carries "
        "over. This page is written by that build."
    )
    add(".PP")
    add(
        "The base set every sandbox gets is in image/Dockerfile, next to it, as "
        "the APT_PACKAGES, BREW_TAPS, BREW_FORMULAE and BREW_CASKS build "
        "arguments. Change one of those and every sandbox on that Mac gets the "
        "change."
    )
    add(".PP")
    add("The config this image was built from is at /etc/sandbox\\-config.toml.")

    add(".SH SECURITY")
    add(
        "A sandbox is a convenience, not a security boundary. It has unrestricted "
        "network access, and credentials written in it are plain files on the "
        "Mac, under ~/Sandboxes/<name>. Do not put a secret in a sandbox that you "
        "would not put on the Mac itself, and do not run untrusted code here "
        "expecting it to be contained. The README covers the scope in full."
    )

    add(".SH FILES")
    add(".TP")
    add("/etc/sandbox\\-config.toml")
    add("The config this image was built from.")
    add(".TP")
    add("~/.sandbox\\-code.log")
    add("The VS Code tunnel log.")
    add(".TP")
    add("/var/log/k3s.log")
    add("The cluster log.")
    add(".TP")
    add("~/.sandbox\\-k3s.img")
    add("The cluster disk.")
    add(".TP")
    add("~/.sandbox\\-seeded")
    add("Marks a home that has been seeded with the shell configuration.")
    add(".TP")
    add("/etc/sandbox\\-nice.sh")
    add("What gives a command run by Claude the standing of background work.")
    add(".TP")
    add("/usr/local/share/man/man7/sandbox.7")
    add("This page.")

    add(".SH SEE ALSO")
    add(roff(REPO))
    add(".PP")
    add(
        "Each tool listed above has its own documentation. Try man <tool>, or "
        "<tool> \\-\\-help where there is no man page."
    )

    sys.stdout.write("\n".join(out) + "\n")


main()
