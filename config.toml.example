[apt]
packages = ["podman"]

[brew]
taps = ["terraform-linters/tap", "hashicorp/tap"]
formulae = [
  "ansible", "awscli", "azure-cli", "cloudflare-wrangler", "fzf", "gh", "go",
  "gum", "hadolint", "hashicorp/tap/terraform", "helm", "helmfile", "htop", "jq",
  "k9s", "kubectl", "kubectx", "kustomize", "lazygit", "lazysql", "mosh", "nano",
  "node", "pre-commit", "sops", "sqlite", "uv", "watch", "yq", "zellij", "zstd",
]
# Casks from a declared tap are trusted automatically (see [brew].taps).
casks = ["claude-code@latest", "gcloud-cli", "tflint"]

[post_install]
# Shell commands run in order after all installs, baked into the image.
commands = []

[resources]
# Passed to `container run`. Omit or leave empty for Apple Container defaults.
memory = "4G"   # optional; K/M/G/T/P suffix
cpus = 4        # optional; integer

[k3s]
# A single-node Kubernetes cluster, started automatically on launch.
#
# This setting is global, so enabling it applies to EVERY sandbox: each gets its
# own cluster, its own disk, and a fully privileged container (k3s needs
# CAP_SYS_ADMIN and CAP_NET_ADMIN, which the default capability set omits — see
# "Security scope" in the README). Needs [resources].memory >= 4G.
enabled = false
disk = "8G"              # sparse ext4 image in the sandbox home holding cluster state
node_ip = "10.99.0.1"    # fixed node address; must not collide with your LAN
